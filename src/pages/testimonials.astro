---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCard from '../components/ui/TestimonialCard.astro';
import { SITE } from '@config/site';

const testimonials = [
  {
    quote: "Excellent costumer service very knowlagable and efficient. The price and reliability and service excellent",
    name: "Paulo David",
    ringColor: "ring-blue-200"
  },
  {
    quote: "Very professional and knowledgeable, fixed my laptop fast and was great pricing. Highly recommended!!!",
    name: "LeighAnn Byrne",
    ringColor: "ring-blue-200"
  },
  {
    quote: "Great service! Very friendly and knowledgeable, extremely helpful and willing to go the extra mile to ensure your computer needs are met and you are fully satisfied.",
    name: "Frank O'Neill",
    ringColor: "ring-blue-200"
  },
  {
    quote: "Very professional, was quick , precise and had my computer fixed in no time. Highly recommend",
    name: "Cynthia Taylor",
    ringColor: "ring-blue-200"
  }
];
---

<BaseLayout title={`Testimonials | ${SITE.title}`} description={`What our customers say about ${SITE.title}. Computer repair and on-site service.`}>
  <section class="py-16 sm:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">What people say</h1>
        <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Real feedback from people we've helped with computer repair and support.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {testimonials.map((testimonial) => (
          <TestimonialCard testimonial={testimonial} variant="home" />
        ))}
      </div>

      <div class="mt-16 text-center">
        <a href="/contact" class="text-[var(--color-primary)] font-semibold hover:underline">
          Get in touch →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
