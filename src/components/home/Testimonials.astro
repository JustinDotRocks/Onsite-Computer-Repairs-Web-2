---
import TestimonialCard from '../ui/TestimonialCard.astro';

const testimonials = [
  {
    quote: "Excellent costumer service very knowlagable and efficient. The price and reliability and service excellent",
    name: "Paulo David",
    ringColor: "ring-blue-200"
  },
  {
    quote: "Very professional and knowledgeable, fixed my laptop fast and was great pricing. Highly recommended!!!",
    name: "LeighAnn Byrne",
    ringColor: "ring-blue-200"
  },
  {
    quote: "Great service! Very friendly and knowledgeable, extremely helpful and willing to go the extra mile to ensure your computer needs are met and you are fully satisfied.",
    name: "Frank O'Neill",
    ringColor: "ring-blue-200"
  },
  {
    quote: "Very professional, was quick , precise and had my computer fixed in no time. Highly recommend",
    name: "Cynthia Taylor",
    ringColor: "ring-blue-200"
  }
];
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 rounded-full text-sm font-semibold" style="background-color: rgba(0, 102, 179, 0.12); color: var(--color-primary);">
        What people say
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">
        Trusted by <span class="gradient-text">our customers</span>
      </h2>
      <p class="text-xl text-[var(--color-text-muted)] max-w-3xl mx-auto leading-relaxed">
        Real feedback from people we've helped with computer repair and support.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {testimonials.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} variant="home" />
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/testimonials" class="text-[var(--color-primary)] font-semibold hover:underline">
        Read more testimonials →
      </a>
    </div>
  </div>
</section>
